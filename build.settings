--
-- build.settings
-- Integrated Apple + Google IAP + iPhone assets + splash
--

settings =
{
    splashScreen =
    {
        enable = true,
        image = "menu-background.png"
    },

    android =
    {
        usesPermissions =
        {
            "android.permission.INTERNET",
            "com.android.vending.BILLING",
        },

        minSdkVersion = "21",
        supportsTV = false,
    },

    iphone =
    {
        plist =
        {
            UILaunchStoryboardName = "LaunchScreen",
        },

        xcassets = "Images.xcassets"
    },

    plugins =
    {
        ["plugin.google.iap.billing.v2"] =
        {
            publisherId = "com.solar2d",
        },

        ["plugin.apple.iap"] =
        {
            publisherId = "com.coronalabs"
        },
    },

    excludeFiles =
    {
        all = { "Icon.png", "Icon-*dpi.png"},
        android = { "LaunchScreen.storyboardc" },
    },
}